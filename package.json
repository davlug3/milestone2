{
  "name": "milestone2-book-animation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-site.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:sim": "esbuild scripts/sim-test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sim-test.mjs && node node_modules/.cache/sim-test.mjs",
    "test:page": "esbuild scripts/page-sim-metrics.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/page-sim-metrics.mjs && node node_modules/.cache/page-sim-metrics.mjs",
    "test:twopage": "esbuild scripts/multipage-check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/multipage-check.mjs && node node_modules/.cache/multipage-check.mjs",
    "test:cover": "esbuild scripts/cover-check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/cover-check.mjs && node node_modules/.cache/cover-check.mjs",
    "test:spine": "esbuild scripts/spine-check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/spine-check.mjs && node node_modules/.cache/spine-check.mjs",
    "test:clearance": "esbuild scripts/clearance-check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/clearance-check.mjs && node node_modules/.cache/clearance-check.mjs",
    "test:binding": "esbuild scripts/binding-check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/binding-check.mjs && node node_modules/.cache/binding-check.mjs",
    "photos:download": "node scripts/download-page-images.mjs",
    "photos:download:jilp": "node scripts/download-jilp-photos.mjs",
    "test:camera": "esbuild scripts/camera-check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/camera-check.mjs && node node_modules/.cache/camera-check.mjs",
    "test:handoff": "esbuild scripts/handoff-check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/handoff-check.mjs && node node_modules/.cache/handoff-check.mjs",
    "test:flex": "esbuild scripts/flex-check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/flex-check.mjs && node node_modules/.cache/flex-check.mjs",
    "test:playback": "esbuild scripts/playback-check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/playback-check.mjs && node node_modules/.cache/playback-check.mjs",
    "test:trace": "esbuild scripts/trace-check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/trace-check.mjs && node node_modules/.cache/trace-check.mjs",
    "render:video": "node scripts/render-video.mjs",
    "test:render-progress": "node scripts/render-progress-check.mjs",
    "render:blender": "node scripts/render-blender.mjs",
    "build:site": "node scripts/build-site.mjs",
    "preview:site": "vite preview --outDir site-dist",
    "test:transport": "node --experimental-strip-types --test scripts/transport.test.mjs",
    "test:page-shape": "esbuild scripts/page-shape-check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/page-shape-check.mjs && node node_modules/.cache/page-shape-check.mjs",
    "test:stats": "node --test scripts/stats.test.mjs",
    "render:stats": "node scripts/render-stats.mjs",
    "test:clothesline": "node --test scripts/clothesline.test.mjs",
    "render:clothesline": "node scripts/render-clothesline.mjs",
    "render:passes": "node scripts/render-passes.mjs",
    "render:floating": "node scripts/render-floating.mjs",
    "test:floating": "node --test scripts/floating.test.mjs",
    "dev:book": "vite",
    "render": "node scripts/render-scene.mjs",
    "benchmark:cycles": "node scripts/benchmark-cycles.mjs",
    "test:cycles": "node --test scripts/cycles-presets.test.mjs scripts/render-lock.test.mjs scripts/binary-cache.test.mjs",
    "render:final": "node scripts/render-final.mjs",
    "status": "node scripts/status.mjs",
    "test:status": "node --test scripts/status.test.mjs",
    "render:realtime": "node scripts/render-realtime.mjs"
  },
  "dependencies": {
    "three": "^0.180.0",
    "three-gpu-pathtracer": "0.0.24",
    "three-mesh-bvh": "0.9.2",
    "xatlas-web": "0.1.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "playwright": "^1.65.1",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
