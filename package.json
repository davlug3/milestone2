{
  "name": "milestone2-book-animation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:sim": "esbuild scripts/sim-test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sim-test.mjs && node node_modules/.cache/sim-test.mjs",
    "test:page": "esbuild scripts/page-sim-metrics.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/page-sim-metrics.mjs && node node_modules/.cache/page-sim-metrics.mjs",
    "test:twopage": "esbuild scripts/multipage-check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/multipage-check.mjs && node node_modules/.cache/multipage-check.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "playwright": "^1.65.1",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
